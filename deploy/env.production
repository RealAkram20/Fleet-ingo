# ---------------------------------------------------------------------------
# Production environment for https://fleet.ingo.co.zw
#
# Copy this file to the project root as ".env" and fill in the three DB_ lines
# with the database, user and password created in cPanel.
#
# APP_KEY encrypts sessions and the stored SMTP password. It is deliberately
# blank in the repository; the deployment zip ships a copy with a key filled
# in, or generate one with `php artisan key:generate`. Never change it once
# live, or every stored secret becomes unreadable.
# ---------------------------------------------------------------------------

APP_NAME="InGo Fleet Log"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fleet.ingo.co.zw
APP_TIMEZONE=Africa/Harare

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One file per day under storage/logs, warnings and worse only.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Fill these in from cPanel > MySQL Databases -----------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANELUSER_fleet
DB_USERNAME=CPANELUSER_fleet
DB_PASSWORD=
# -----------------------------------------------------------------------------

# Sessions live in the database, encrypted, and the cookie is HTTPS-only.
# The site is served from the root of the subdomain, so the cookie path is /.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_COOKIE=ingo_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# sync: shared hosting has no queue worker, so nothing may wait in a queue.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=ingo_

# Outgoing mail is configured from the Settings screen once signed in; until
# an SMTP host is saved there, mail is written to storage/logs instead.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="fleet@ingo.co.zw"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
