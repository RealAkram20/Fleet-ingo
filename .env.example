APP_NAME="InGo Fleet Log"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/ingo
APP_TIMEZONE=Africa/Harare

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ingo_fleet
DB_USERNAME=root
DB_PASSWORD=

# Scoped to this project so it cannot collide with the other htdocs apps on localhost
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_COOKIE=ingo_session
SESSION_PATH=/ingo
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=ingo_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="fleet@ingo.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
